{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Whisper",
  "version": "1.0.0",
  "identifier": "com.xstudiolabs.xwhisper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "island",
        "title": "",
        "url": "index.html?window=island",
        "width": 520,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../python-engine/*.py",
      "../python-engine/*.ps1",
      "../python-engine/requirements.txt",
      "../python-engine/providers/*.py",
      "../python-engine/providers/__init__.py",
      "../binaries/whisper-cpp/cpu/whisper-cli.exe",
      "../binaries/whisper-cpp/cpu/*.dll",
      "../binaries/whisper-cpp/cuda/whisper-cli.exe",
      "../binaries/whisper-cpp/cuda/*.dll",
      "../binaries/whisper-cpp/vulkan/whisper-cli.exe",
      "../binaries/whisper-cpp/vulkan/*.dll",
      "../binaries/ffmpeg/ffmpeg.exe"
    ]
  }
}
